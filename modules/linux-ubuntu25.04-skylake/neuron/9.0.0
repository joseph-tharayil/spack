module-whatis {NEURON is a simulation environment for single and networks of neurons.}

proc ModulesHelp { } {
    puts stderr {Name   : neuron}
    puts stderr {Version: 9.0.0}
    puts stderr {Target : skylake}
    puts stderr {}
    puts stderr {NEURON is a simulation environment for single and networks of neurons.}
    puts stderr {NEURON is a simulation environment for modeling individual and networks}
    puts stderr {of neurons. NEURON models individual neurons via the use of sections}
    puts stderr {that are automatically subdivided into individual compartments, instead}
    puts stderr {of requiring the user to manually create compartments.}
}


